  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>BAD CARRETE DAY</b> \u2014 Nivel 1: \"El Pastero\"\nProyecto acad\xE9mico
    \xB7 Desarrollo de Videojuegos \xB7 UCSC 2026\nInspirado en la jugabilidad de
    Conker's Bad Fur Day (Rare). Personajes, mundo e historia originales.\n\n<b>C\xF3digo
    base</b>: repositorio de clase ClaseUCSC2026 \xB7 Unity Starter Assets \u2013
    Third Person (Unity Companion License)\n<b>Personajes y animaciones</b>: Mixamo
    (Adobe) \u2014 Aj, Peasant Man, Mremireh O Desbiens, James, David, Martha\n<b>Entorno</b>:
    KayKit City Builder, Restaurant y Furniture Bits \u2014 Kay Lousberg (CC0)\nKenney
    City Kit Suburban, Roads, Industrial y Cube Pets \u2014 Kenney.nl (CC0)\n<b>M\xFAsica</b>:
    \"Stumble Around\" \u2014 Zane Little Music (CC0) \xB7 \"Comedy Funny Background
    Song\" \u2014 Almitory (CC0)\nJingles: Kenney Music Jingles (CC0)\n<b>Sonidos</b>:
    \"Dog barking mono\" \u2014 Brandon Morris, OpenGameArt (CC0) \xB7 Kenney Impact
    Sounds (CC0)\n<b>Fuente</b>: Luckiest Guy \u2014 Astigmatic (Apache License 2.0)\n\nHecho
    con Unity 6."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
